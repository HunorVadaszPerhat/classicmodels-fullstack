<?xml version="1.0" encoding="UTF-8"?>
<!--
    Project-local Maven settings.

    Used INSTEAD OF the global ~/.m2/settings.xml when Maven is invoked
    with `-s settings.xml`. The .mvn/maven.config file in this project
    adds that flag automatically, so every ./mvnw call uses this file.

    Why? The global settings on this machine route all dependencies
    through a private Nexus mirror (nexus.sloen.dk). That's the right
    default for most projects but it's intermittently unavailable, so
    for THIS project we explicitly fetch dependencies straight from
    Maven Central instead.

    The file is intentionally minimal: no mirrors, no servers, no
    profiles. Maven falls back to its built-in defaults — namely
    https://repo.maven.apache.org/maven2/ — which is what we want.

    Side effects:
      - All credentials/proxies from ~/.m2/settings.xml are NOT inherited.
        This project doesn't need any (public dependencies only), but
        if you ever add a private repo later, copy the relevant <server>
        block here.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- Cache resolved artifacts in the standard ~/.m2/repository
         alongside everything else. (The default; documented for
         clarity since some setups parameterise this.) -->
    <localRepository>${user.home}/.m2/repository</localRepository>

    <!-- Empty <mirrors/> section is the whole point: no redirection,
         so requests for repo.maven.apache.org go directly to
         repo.maven.apache.org. -->
    <mirrors/>

</settings>
